{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoshuaLelon/product-lint/schema/canonical-node.schema.json",
  "title": "Product Lint canonical knowledge node",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "level", "statement", "constrainedBy"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^(audience|context|product|behavior|architecture|mechanism)\\.[a-z0-9][a-z0-9._-]*$"
    },
    "level": {
      "enum": ["audience", "context", "product", "behavior", "architecture", "mechanism"]
    },
    "statement": { "type": "string", "minLength": 1 },
    "draft": { "const": true },
    "constrainedBy": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraintsDigest"],
      "properties": {
        "constraintsDigest": { "type": "string" },
        "vocabularyDigest": { "type": "string" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "digest"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "digest": { "type": "string" }
      }
    }
  }
}
