{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoshuaLelon/product-lint/schema/term-node.schema.json",
  "title": "Product Lint term node",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "level", "name", "definition"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^term\\.[a-z0-9][a-z0-9._-]*$"
    },
    "level": {
      "enum": ["product", "behavior", "architecture", "mechanism"]
    },
    "name": { "type": "string", "minLength": 1 },
    "definition": { "type": "string", "minLength": 1 },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vocabularyDigest"],
      "properties": {
        "vocabularyDigest": { "type": "string" }
      }
    }
  }
}
