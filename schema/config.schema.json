{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoshuaLelon/product-lint/schema/config.schema.json",
  "title": "Product Lint configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "root": { "type": "string" },
    "knowledgeRoot": { "type": "string" },
    "governedPaths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trailer": { "type": "string", "minLength": 1 },
        "requireBody": { "type": "boolean" },
        "subjectPattern": {
          "type": "string",
          "minLength": 1,
          "description": "Optional regular expression the commit subject must match. Omit to leave the subject unconstrained."
        }
      }
    },
    "attest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "enum": ["context", "product", "behavior", "architecture", "mechanism"]
          },
          "description": "Levels whose cohorts need a recorded review. Defaults to product, behavior, and architecture. An empty array turns attestation off."
        }
      }
    }
  }
}
